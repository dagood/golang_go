# This file contains the initial defaults for go command configuration.
# Values set by 'go env -w' and written to the user's go/env file override these.
# The environment overrides everything else.

# Use the Go module mirror and checksum database by default.
# See https://proxy.golang.org for details.
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org

# Automatically download newer toolchains as directed by go.mod files.
# See https://go.dev/doc/toolchain for details.
GOTOOLCHAIN=auto

# Treat the standard library ("std" and "cmd") as a normal module when building
# from this source tree, so a fresh clone builds and develops without setting
# GOSTDMODULE manually. The re-vendoring/publish process strips this line so the
# published toolset falls back to the default (off). Override with the
# GOSTDMODULE environment variable in either direction.
GOSTDMODULE=1
